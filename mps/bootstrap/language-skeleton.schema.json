{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gcpl:nltps:schema:mps-language-skeleton:0.2",
  "title": "GCPL / NL-TPS MPS language-skeleton blueprint",
  "type": "object",
  "required": [
    "schema_version",
    "skeleton_version",
    "decision",
    "architecture_baseline",
    "implementation_state",
    "project",
    "languages"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "skeleton_version": {
      "const": "0.2"
    },
    "decision": {
      "const": "ADR-001"
    },
    "architecture_baseline": {
      "type": "string",
      "pattern": "^ENG-PKG-01-v[0-9]+\\.[0-9]+$"
    },
    "implementation_state": {
      "const": "blueprint_not_live_mps_serialization"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "namespace_prefix",
        "default_model_persistence",
        "patient_data_permitted",
        "clinical_credentials_permitted",
        "direct_persistence_xml_edit_permitted"
      ],
      "properties": {
        "name": {
          "const": "NLTPSGovernance"
        },
        "namespace_prefix": {
          "const": "nltps"
        },
        "default_model_persistence": {
          "const": "file-per-root"
        },
        "patient_data_permitted": {
          "const": false
        },
        "clinical_credentials_permitted": {
          "const": false
        },
        "direct_persistence_xml_edit_permitted": {
          "const": false
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "materialized_at",
          "concepts_materialized_at",
          "dependencies",
          "external_explicit",
          "owns",
          "root_concepts",
          "non_root_concepts",
          "required_constraints"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^nltps\\.[a-z]+(\\.[a-z]+)*$"
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "root_concepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "non_root_concepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "required_constraints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "kind"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "EXTENDS",
                    "DEFAULT"
                  ]
                }
              }
            }
          },
          "materialized_at": {
            "type": "string",
            "pattern": "^MPS-[0-9]+$",
            "description": "Checkpoint at which this language module is materialized in MPS. The module graph gate compares only languages materialized at or before the checkpoint under test, so the blueprint may declare a language before it exists on disk."
          },
          "concepts_materialized_at": {
            "type": "string",
            "pattern": "^MPS-[0-9]+$",
            "description": "Checkpoint at which this language's declared concept inventory is materialized. Distinct from materialized_at, which is when the empty module is created: all four original modules exist from MPS-0 while their concepts arrive later. The module graph gate derives the expected concept count from this field."
          },
          "external_explicit": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Explicit non-NL-TPS module dependencies this language is permitted to declare in its .mpl <dependencies> block. Empty unless deliberately amended. MPS adds such dependencies automatically; leaving them undeclared would convert tool behaviour into architecture."
          }
        }
      },
      "description": "Declared language modules. The count is open because the blueprint describes the architecture ahead of materializing it; check_module_graph.py compares only those whose materialized_at checkpoint has arrived."
    },
    "dependency_kind_policy": {
      "type": "object"
    }
  }
}
