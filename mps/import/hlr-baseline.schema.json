{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gcpl:nltps:schema:hlr-baseline:0.1",
  "title": "NL-TPS 119-HLR Stage A Mirror Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "authority_stage",
    "authoritative",
    "controlled_context",
    "source",
    "classification_source",
    "expected_domain_counts",
    "expected_category_counts",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^NLTPS-HLR-MIRROR-[0-9]+\\.[0-9]+$"
    },
    "authority_stage": {
      "const": "A_mirror"
    },
    "authoritative": {
      "const": false
    },
    "controlled_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_baseline",
        "technology_name",
        "technology_acronym",
        "implementation_alias"
      ],
      "properties": {
        "architecture_baseline": {
          "type": "string",
          "minLength": 1
        },
        "technology_name": {
          "type": "string",
          "minLength": 1
        },
        "technology_acronym": {
          "type": "string",
          "minLength": 1
        },
        "implementation_alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "document_id",
        "requirements_version",
        "source_date",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "expected_domain_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GOV",
        "SAF",
        "NLI",
        "EVD",
        "CLN",
        "PLN",
        "REV",
        "DAT",
        "AIM",
        "HFE",
        "SEC",
        "OPS",
        "VAL",
        "ACC"
      ],
      "properties": {
        "GOV": {
          "const": 7
        },
        "SAF": {
          "const": 10
        },
        "NLI": {
          "const": 8
        },
        "EVD": {
          "const": 8
        },
        "CLN": {
          "const": 9
        },
        "PLN": {
          "const": 12
        },
        "REV": {
          "const": 9
        },
        "DAT": {
          "const": 10
        },
        "AIM": {
          "const": 8
        },
        "HFE": {
          "const": 6
        },
        "SEC": {
          "const": 8
        },
        "OPS": {
          "const": 7
        },
        "VAL": {
          "const": 9
        },
        "ACC": {
          "const": 8
        }
      }
    },
    "record_count": {
      "const": 119
    },
    "records": {
      "type": "array",
      "minItems": 119,
      "maxItems": 119,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "normative_text_latex",
          "normative_text_plain",
          "source_hazard_latex",
          "source_hazard_plain",
          "verification_methods",
          "source_line",
          "record_sha256",
          "category",
          "category_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{3}$"
          },
          "domain": {
            "enum": [
              "GOV",
              "SAF",
              "NLI",
              "EVD",
              "CLN",
              "PLN",
              "REV",
              "DAT",
              "AIM",
              "HFE",
              "SEC",
              "OPS",
              "VAL",
              "ACC"
            ]
          },
          "normative_text_latex": {
            "type": "string",
            "minLength": 1
          },
          "normative_text_plain": {
            "type": "string",
            "minLength": 1
          },
          "source_hazard_latex": {
            "type": "string",
            "minLength": 1
          },
          "source_hazard_plain": {
            "type": "string",
            "minLength": 1
          },
          "verification_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "I",
                "A",
                "T",
                "D",
                "HFE"
              ]
            }
          },
          "source_line": {
            "type": "integer",
            "minimum": 1
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "category": {
            "enum": [
              "functional",
              "cross_cutting_safety_and_assurance_constraint",
              "operational"
            ]
          },
          "category_id": {
            "type": "string",
            "pattern": "^(HFR|HNFR|HOR)-[A-Z]{3}-[0-9]{3}$"
          }
        }
      }
    },
    "classification_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "expected_category_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional",
        "cross_cutting_safety_and_assurance_constraint",
        "operational"
      ],
      "properties": {
        "functional": {
          "const": 69
        },
        "cross_cutting_safety_and_assurance_constraint": {
          "const": 25
        },
        "operational": {
          "const": 25
        }
      }
    }
  }
}
