{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gcpl:nltps:schema:decisions:0.2",
  "title": "GCPL / NL-TPS architecture decision specification",
  "type": "object",
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "version",
          "date",
          "status",
          "approval_state",
          "owner",
          "human_readable_source",
          "decision",
          "recorded_approvals"
        ],
        "properties": {
          "id": {"enum": ["ADR-001", "ADR-002"]},
          "title": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "status": {"type": "string", "minLength": 1},
          "approval_state": {"enum": ["pending_named_approval", "approved", "withdrawn"]},
          "owner": {"type": "string", "minLength": 1},
          "human_readable_source": {"type": "string", "minLength": 1},
          "recorded_approvals": {"type": "array"}
        }
      }
    }
  }
}
