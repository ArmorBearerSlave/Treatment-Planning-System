{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gcpl:nltps:schema:requirement:0.1",
  "title": "GCPL / NL-TPS constructed requirement specification",
  "$comment": "The normative statement already exists and is hash-bound to its source. Construction adds the acceptance criterion, applicability, and allocation that make it verifiable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entity_class",
    "construction_state",
    "canonical_statement_sha256",
    "domain",
    "classification",
    "acceptance_kind",
    "verification_methods",
    "applicability",
    "allocated_components",
    "hazards",
    "hazard_basis",
    "vv_claim_id"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$"},
    "entity_class": {"const": "requirement"},
    "construction_state": {"enum": ["draft", "reviewed", "approved"]},
    "constructed_by": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": ["string", "null"]},
    "review_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "canonical_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {
      "enum": ["GOV", "SAF", "NLI", "EVD", "CLN", "PLN", "REV", "DAT", "AIM", "HFE", "SEC", "OPS", "VAL", "ACC"]
    },
    "classification": {
      "enum": ["functional", "cross_cutting_safety_and_assurance_constraint", "operational"]
    },
    "acceptance_kind": {"enum": ["quantitative", "qualitative"]},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion"],
      "properties": {
        "criterion": {"type": "string", "minLength": 20},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "tolerance": {"type": ["number", "string", "null"]},
        "tolerance_source": {"type": ["string", "null"]},
        "quality_target_id": {"type": ["string", "null"], "pattern": "^QT-[A-Z]+-[0-9]{3}$"}
      }
    },
    "verification_methods": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["I", "T", "A", "D", "HFE"]}
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_class", "record_id"],
      "properties": {
        "record_class": {"enum": ["ETS", "MER", "CMR", "CVR"]},
        "record_id": {"type": "string", "minLength": 3}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "slices"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["training", "commissioning", "shadow", "clinical_draft", "clinical_approved", "degraded"]
          }
        },
        "slices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "machines": {"type": "array", "items": {"type": "string"}},
        "techniques": {"type": "array", "items": {"type": "string"}}
      }
    },
    "allocated_components": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(C|IC|FC|NFC|OC)-[A-Z0-9-]+-[0-9]{2}$"}
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^H-[0-9]{2}$"}
    },
    "hazard_basis": {"enum": ["source_explicit", "derived"]},
    "hazard_rationale": {"type": ["string", "null"]},
    "vv_claim_id": {"type": "string", "pattern": "^VVC-HLR:[A-Z]{3}-[0-9]{3}$"},
    "blocking_decisions": {"type": "array", "items": {"type": "string", "pattern": "^D-ENG-[0-9]{3}$"}},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "$comment": "A quantitative criterion carries a value, a unit, and where the tolerance came from.",
      "if": {
        "properties": {"acceptance_kind": {"const": "quantitative"}},
        "required": ["acceptance_kind"]
      },
      "then": {
        "required": ["acceptance"],
        "properties": {
          "acceptance": {
            "required": ["criterion", "value", "unit", "tolerance_source"],
            "properties": {
              "unit": {"type": "string", "minLength": 1},
              "tolerance_source": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    },
    {
      "$comment": "A qualitative criterion must instead name the evidence record that closes it.",
      "if": {
        "properties": {"acceptance_kind": {"const": "qualitative"}},
        "required": ["acceptance_kind"]
      },
      "then": {"required": ["acceptance", "evidence_binding"]}
    },
    {
      "$comment": "A reviewed or approved requirement carries reviewed hazards and a named reviewer.",
      "if": {
        "properties": {"construction_state": {"enum": ["reviewed", "approved"]}},
        "required": ["construction_state"]
      },
      "then": {
        "required": ["reviewed_by", "review_date", "hazard_rationale"],
        "properties": {
          "hazard_basis": {"const": "source_explicit"},
          "reviewed_by": {"type": "string", "minLength": 1},
          "hazard_rationale": {"type": "string", "minLength": 20}
        }
      }
    }
  ]
}
